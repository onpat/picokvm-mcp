# MCP bridge listening address (defaults: 0.0.0.0:8000)
PICOKVM_MCP_HOST=0.0.0.0
PICOKVM_MCP_PORT=8000

# REST API base url for mcp, upload, download
PICOKVM_BASE_URL=http://192.168.1.201

# Only if the device requires a password
# PICOKVM_PASSWORD='your-password'

# Optional: for kvm_capture_screenshot (enable the device MCP server first).
PICOKVM_MCP_API_KEY='your-device-mcp-api-key'
PICOKVM_MCP_URL=http://192.168.1.201:8081/mcp

# set to configure 1024x768 @ 60Hz at startup
# EDID_AUTOSET=1
